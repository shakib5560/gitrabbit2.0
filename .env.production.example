# ==============================================================================
# GitRabbit Production Environment Configuration (.env.production)
# ==============================================================================
# IMPORTANT: Keep this file secure on your EC2 host. Never commit actual secrets!
# ==============================================================================

# Node Environment
NODE_ENV=production

# Public Domain / Hostname & EC2 Host IP
DOMAIN_NAME=api.gitrabbit.co
EC2_HOST=3.110.66.16
APP_URL=https://api.gitrabbit.co
FRONTEND_URL=https://gitrabbit.co
DASHBOARD_URL=https://gitrabbit.co/app
LOGIN_URL=https://gitrabbit.co/login

# ------------------------------------------------------------------------------
# PostgreSQL Database Credentials (Internal Network Only)
# ------------------------------------------------------------------------------
# Auth DB
AUTH_DB_USER=gitrabbit_auth
AUTH_DB_PASSWORD=generate_a_secure_auth_password_here
AUTH_DB_NAME=auth_db

# AI DB
AI_DB_USER=gitrabbit_ai
AI_DB_PASSWORD=generate_a_secure_ai_password_here
AI_DB_NAME=ai_db

# Blog DB
BLOG_DB_USER=gitrabbit_blog
BLOG_DB_PASSWORD=generate_a_secure_blog_password_here
BLOG_DB_NAME=blog_db

# ------------------------------------------------------------------------------
# Internal Connection Strings (Connecting via Docker Service DNS)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://${AUTH_DB_USER}:${AUTH_DB_PASSWORD}@auth-db:5432/${AUTH_DB_NAME}?schema=public
AI_DATABASE_URL=postgresql+asyncpg://${AI_DB_USER}:${AI_DB_PASSWORD}@ai-db:5432/${AI_DB_NAME}
BLOG_DATABASE_URL=postgresql://${BLOG_DB_USER}:${BLOG_DB_PASSWORD}@blog-postgres:5432/${BLOG_DB_NAME}?schema=public
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# JWT Authentication Secrets (Generate with `openssl rand -hex 32`)
# ------------------------------------------------------------------------------
JWT_SECRET=generate_strong_random_jwt_secret_here
JWT_ACCESS_SECRET=generate_strong_random_jwt_secret_here
JWT_EXPIRES_IN=25m
JWT_REFRESH_SECRET=generate_strong_random_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# ------------------------------------------------------------------------------
# Mail SMTP Configuration (Transactional Emails)
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password
MAIL_FROM="GitRabbit <noreply@gitrabbit.co>"

# ------------------------------------------------------------------------------
# GitHub OAuth Credentials
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL="https://api.gitrabbit.co/api/auth/github/callback"

# ------------------------------------------------------------------------------
# AI Service API Keys
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your_production_openai_key
ANTHROPIC_API_KEY=sk-ant-your_production_anthropic_key
