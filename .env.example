# Database configurations
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=microservices
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Auth DB
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=postgres
AUTH_DB_NAME=auth_db
AUTH_DB_PORT=5433

# AI DB
AI_DB_USER=postgres
AI_DB_PASSWORD=postgres
AI_DB_NAME=ai_db
AI_DB_PORT=5434

# Blog DB
BLOG_DB_USER=postgres
BLOG_DB_PASSWORD=postgres
BLOG_DB_NAME=blog_db
BLOG_DB_PORT=5435

# Redis
REDIS_URL=redis://redis:6379

# Public URLs
API_URL="https://gitrabbit.co/api/v2.0"
DASHBOARD_URL="https://gitrabbit.co/app/v2.0"
LOGIN_URL="https://www.gitrabbit.co/login"
FRONTEND_URL="https://gitrabbit.co"

# Mail SMTP Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM="GitRabbit <your_email@gmail.com>"

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL="https://gitrabbit.co/api/v2.0/auth/github/callback"

# Service URLs (Internal)
AUTH_SERVICE_URL=http://auth-service:3000
AI_SERVICE_URL=http://ai-service:8000
BLOG_SERVICE_URL=http://blog-service:4000

# Auth Service JWT & Database
JWT_SECRET=super_secret_jwt_key
JWT_ACCESS_SECRET=super_secret_jwt_key
JWT_EXPIRES_IN=25m
JWT_REFRESH_SECRET=super_secret_refresh_key
JWT_REFRESH_EXPIRES_IN=30d
DATABASE_URL=postgresql://${AUTH_DB_USER}:${AUTH_DB_PASSWORD}@auth-db:5432/${AUTH_DB_NAME}?schema=public

# Blog Service
BLOG_DATABASE_URL=postgresql://${BLOG_DB_USER}:${BLOG_DB_PASSWORD}@blog-postgres:5432/${BLOG_DB_NAME}?schema=public

# AI Service
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_DATABASE_URL=postgresql+asyncpg://${AI_DB_USER}:${AI_DB_PASSWORD}@ai-db:5432/${AI_DB_NAME}

# Ports for localhost exposure
API_GATEWAY_PORT=80
AUTH_SERVICE_PORT=3000
AI_SERVICE_PORT=8000
BLOG_SERVICE_PORT=4000

